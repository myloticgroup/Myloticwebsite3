{
  "name": "mylotic-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch server/src/server.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/src/server.ts",
    "build:client": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "vite build && tsc -p server/tsconfig.json",
    "start": "node server/dist/server.js",
    "lint": "eslint src server"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^1.33.0",
    "mongoose": "^8.10.0",
    "multer": "^1.4.5-lts.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.2.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.1.0"
  }
}
