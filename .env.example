# ==============================================================================
# MYLOTIC GROUP — BACKEND CONFIGURATION TEMPLATE (NODE.JS / EXPRESS / MONGODB)
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB + Mongoose)
# ------------------------------------------------------------------------------
# Server-side connection string. NEVER hardcode or expose to frontend.
MONGODB_URI="mongodb://localhost:27017/mylotic_db"

# ------------------------------------------------------------------------------
# 2. SERVER RUNTIME & ENVIRONMENT
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"

# ------------------------------------------------------------------------------
# 3. ADMIN & RECRUITMENT API SECURITY
# ------------------------------------------------------------------------------
# Secret key or Bearer token required for administrative endpoints
ADMIN_API_KEY=""
JWT_SECRET=""

# ------------------------------------------------------------------------------
# 4. OBJECT STORAGE CONFIGURATION (Resumes & Documents)
# ------------------------------------------------------------------------------
# In development: If left blank, resumes default to local uploads/resumes/
# In production: Configure S3-compatible storage (AWS S3, Cloudflare R2, MinIO, GCP)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_PUBLIC_URL=""

# ------------------------------------------------------------------------------
# 5. EMAIL & NOTIFICATION DISPATCH (Transactional / SMTP)
# ------------------------------------------------------------------------------
# In development: If left blank, notifications log directly to the server console.
# In production: Configure SMTP relay or transactional email provider
EMAIL_FROM="notifications@mylotic.com"
NOTIFICATION_EMAIL="leads@mylotic.com"
RECRUITMENT_EMAIL="careers@mylotic.com"

# Optional SMTP Settings
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Optional Transactional API Keys
RESEND_API_KEY=""
SENDGRID_API_KEY=""
