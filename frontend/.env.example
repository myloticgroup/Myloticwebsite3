# Leave BLANK for local dev — Vite's dev-server proxy (vite.config.ts) forwards
# /api and /uploads to http://localhost:5000 automatically.
# Set this when frontend and backend are deployed on separate hosts (e.g. Vercel + Render):
# VITE_API_URL="https://api.mylotic.com"
VITE_API_URL=

# EmailJS Service Configuration (for receiving inquiries directly via email):
# 1. Register at https://www.emailjs.com/
# 2. Add an Email Service (e.g., Gmail) -> Copy Service ID
# 3. Create an Email Template -> Copy Template ID
# 4. In Account Settings -> Copy Public Key
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
